{
  "name": "frameforge-studio",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "An AI-Native, Professional-Grade Non-Linear Video Editing & VFX Application",
  "author": "FrameForge Studio Team",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @frameforge/desktop run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "clean": "pnpm -r exec rimraf dist node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
